# ═══════════════════════════════════════════════════════════════
# UserController Comprehensive QA
# Covers: boundary values, state transitions, CRUD cycles, wallet isolation
# ═══════════════════════════════════════════════════════════════
{"_suiteVars":{"suitePrefix":"usercontroller_qa"}}

# ─── Registration Boundary Tests ───
{"id":"register_minimal","description":"Register with only required fields","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_min","email":"{{suitePrefix}}_min@qa.azoa","password":"Pass123!"},"expectedStatus":200,"extract":{"id":"result.id","email":"result.email"},"saveAs":"minimalUser"}
{"id":"register_full_profile","description":"Register with all profile fields populated","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_fullprofile","email":"{{suitePrefix}}_full@qa.azoa","password":"ComplexPass123!","title":"Dr.","firstName":"Full","lastName":"Profile"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"fullUser"}
{"id":"register_unicode_username","description":"Register with Unicode username","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_用户_ tester","email":"{{suitePrefix}}_unicode@qa.azoa","password":"Pass123!"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"unicodeUser"}
{"id":"register_special_chars_email","description":"Register with email containing plus alias","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_plusemail","email":"{{suitePrefix}}_test+alias@qa.azoa","password":"Pass123!"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"plusUser"}
{"id":"register_long_username","description":"Register with 50-char username","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_verylongusernamethatistotaloffiftycharacterslong","email":"{{suitePrefix}}_longuser@qa.azoa","password":"Pass123!"},"expectedStatus":200}

# ─── Duplicate Detection ───
{"id":"register_duplicate_username","description":"Register duplicate username should succeed (no unique constraint on username)","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_min","email":"{{suitePrefix}}_different@qa.azoa","password":"Pass123!"},"expectedStatus":200}
{"id":"register_duplicate_email","description":"Register duplicate email should fail","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_dupetest","email":"{{suitePrefix}}_min@qa.azoa","password":"Pass123!"},"expectedStatus":400}

# ─── Login Tests ───
{"id":"login_minimal","description":"Login as minimal user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_min@qa.azoa","password":"Pass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"minimalAuth"}
{"id":"login_full","description":"Login as full profile user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_full@qa.azoa","password":"ComplexPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"fullAuth"}
{"id":"login_unicode","description":"Login as unicode user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_unicode@qa.azoa","password":"Pass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"unicodeAuth"}
{"id":"login_wrong_password","description":"Login with wrong password","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_min@qa.azoa","password":"WrongPass123!"},"expectedStatus":401}
{"id":"login_nonexistent","description":"Login with non-existent email","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"doesnotexist@qa.azoa","password":"Pass123!"},"expectedStatus":401}
{"id":"login_empty_body","description":"Login with empty body","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{},"expectedStatus":400}

# ─── Authenticated Get Tests ───
{"id":"get_minimal_user","description":"Get minimal user by ID","method":"GET","path":"/api/user/{{minimalUser.id}}","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":200}
{"id":"get_full_user","description":"Get full profile user by ID","method":"GET","path":"/api/user/{{fullUser.id}}","headers":{"Authorization":"Bearer {{fullAuth.token}}"},"expectedStatus":200}
{"id":"get_nonexistent_user","description":"Get non-existent user returns 404","method":"GET","path":"/api/user/00000000-0000-0000-0000-000000000000","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":404}

# ─── GetAll Tests ───
{"id":"get_all_users","description":"List all users should include seeded ones","method":"GET","path":"/api/user","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":200}

# ─── Update Tests ───
{"id":"update_title","description":"Update only title field","method":"PUT","path":"/api/user/{{minimalUser.id}}","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"title":"UpdatedTitle"},"expectedStatus":200}
{"id":"update_email","description":"Update email address","method":"PUT","path":"/api/user/{{minimalUser.id}}","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"email":"{{suitePrefix}}_updated@qa.azoa"},"expectedStatus":200}
{"id":"update_multiple_fields","description":"Update multiple fields at once","method":"PUT","path":"/api/user/{{fullUser.id}}","headers":{"Content-Type":"application/json","Authorization":"Bearer {{fullAuth.token}}"},"body":{"firstName":"UpdatedFirst","lastName":"UpdatedLast","title":"Prof."},"expectedStatus":200}
{"id":"update_nonexistent","description":"Update non-existent user","method":"PUT","path":"/api/user/00000000-0000-0000-0000-000000000000","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"title":"Ghost"},"expectedStatus":404}

# ─── Wallet CRUD Tests ───
{"id":"add_algorand_wallet","description":"Add Algorand wallet to user","method":"POST","path":"/api/user/{{minimalUser.id}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"chainType":"Algorand","address":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ","label":"AlgoDev","isDefault":true},"expectedStatus":200,"extract":{"walletId":"result.id"},"saveAs":"algoWallet"}
{"id":"add_solana_wallet","description":"Add Solana wallet to user","method":"POST","path":"/api/user/{{minimalUser.id}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"chainType":"Solana","address":"HN7cABqLq46Es1jh92dQQisAq662SmxELLLsHHe4YWrH","label":"SolDev","isDefault":false},"expectedStatus":200,"extract":{"walletId":"result.id"},"saveAs":"solWallet"}
{"id":"add_second_algorand_wallet","description":"Add second Algorand wallet (same user)","method":"POST","path":"/api/user/{{minimalUser.id}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{minimalAuth.token}}"},"body":{"chainType":"Algorand","address":"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBA5HFKQ","label":"AlgoTest2"},"expectedStatus":200}
{"id":"get_wallets","description":"Get all wallets for user","method":"GET","path":"/api/user/{{minimalUser.id}}/wallets","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":200}
{"id":"remove_solana_wallet","description":"Remove Solana wallet","method":"DELETE","path":"/api/user/{{minimalUser.id}}/wallets/{{solWallet.walletId}}","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":200}
{"id":"remove_nonexistent_wallet","description":"Remove non-existent wallet returns 404","method":"DELETE","path":"/api/user/{{minimalUser.id}}/wallets/00000000-0000-0000-0000-000000000000","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":404}

# ─── Wallet Isolation ───
{"id":"add_wallet_to_other_user","description":"Add wallet to another user (should succeed - manager allows any userId)","method":"POST","path":"/api/user/{{fullUser.id}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{fullAuth.token}}"},"body":{"chainType":"Solana","address":"DummyAddress1234567890123456789012345678901234567890","label":"OtherWallet"},"expectedStatus":200}

# ─── Auth Boundary Tests ───
{"id":"get_without_auth","description":"Get user without auth returns 401","method":"GET","path":"/api/user/{{minimalUser.id}}","headers":{},"expectedStatus":401}
{"id":"get_with_malformed_auth","description":"Get user with malformed Bearer token","method":"GET","path":"/api/user/{{minimalUser.id}}","headers":{"Authorization":"Bearer invalid.token.here"},"expectedStatus":401}

# ─── Cleanup ───
{"id":"delete_minimal_user","description":"Delete minimal user","method":"DELETE","path":"/api/user/{{minimalUser.id}}","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":200}
{"id":"delete_full_user","description":"Delete full profile user","method":"DELETE","path":"/api/user/{{fullUser.id}}","headers":{"Authorization":"Bearer {{fullAuth.token}}"},"expectedStatus":200}
{"id":"delete_unicode_user","description":"Delete unicode user","method":"DELETE","path":"/api/user/{{unicodeUser.id}}","headers":{"Authorization":"Bearer {{unicodeAuth.token}}"},"expectedStatus":200}
{"id":"verify_deleted","description":"Verify deleted user returns 404","method":"GET","path":"/api/user/{{minimalUser.id}}","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":404}
{"id":"delete_nonexistent","description":"Delete non-existent user","method":"DELETE","path":"/api/user/00000000-0000-0000-0000-000000000000","headers":{"Authorization":"Bearer {{minimalAuth.token}}"},"expectedStatus":404}
