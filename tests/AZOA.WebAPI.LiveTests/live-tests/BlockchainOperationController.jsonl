# ═══════════════════════════════════════════════════════════════
# BlockchainOperationController live API payloads
# This suite seeds an user and a blockchain operation, then queries by ID and user.
# ═══════════════════════════════════════════════════════════════
{"_suiteVars":{"suitePrefix":"blockchainoperationcontroller"}}
{"id":"seed_user","description":"Register user for blockchain operation tests","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_blockchaintest","email":"{{suitePrefix}}_blockchain@test.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"userId":"result.id"},"saveAs":"buser"}
{"id":"login_seed","description":"Login as blockchain test user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_blockchain@test.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"bauth"}
{"id":"seed_wallet","description":"Add a wallet for the user","method":"POST","path":"/api/user/{{buser.userId}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bauth.token}}"},"body":{"chainType":"Algorand","address":"TESTADDR12345678901234567890123456789012345678901234567890","label":"LiveTest"},"expectedStatus":200,"extract":{"walletId":"result.id"},"saveAs":"bwallet"}
{"id":"get_operations_by_user","description":"Get operations by user (may be empty)","method":"GET","path":"/api/blockchainoperation/user/{{buser.userId}}","headers":{"Authorization":"Bearer {{bauth.token}}"},"expectedStatus":200}
{"id":"cleanup_wallet","description":"Remove the seeded wallet","method":"DELETE","path":"/api/user/{{buser.userId}}/wallets/{{bwallet.walletId}}","headers":{"Authorization":"Bearer {{bauth.token}}"},"expectedStatus":200}
{"id":"cleanup_user","description":"Remove the seeded user","method":"DELETE","path":"/api/user/{{buser.userId}}","headers":{"Authorization":"Bearer {{bauth.token}}"},"expectedStatus":200}
