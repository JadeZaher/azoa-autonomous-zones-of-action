{"id":"sqli_generate_config","description":"SQLi in generation config","method":"POST","path":"/api/actiongraphbundle/{{targetBundle.id}}/generate","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleMalAuth.token}}"},"body":{"targetChain":"Algorand","boundHolonIds":[],"config":{"evil":"'; DELETE FROM users; --"}},"expectedStatus":200}

