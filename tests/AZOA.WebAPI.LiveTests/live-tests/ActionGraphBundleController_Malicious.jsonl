{"id":"login_user","description":"Login as action graph bundle test user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_bundlemal@mal.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"bundleMalAuth"}
{"id":"seed_bundle","description":"Create seed bundle for attack tests","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleMalAuth.token}}"},"body":{"name":"TargetBundle","description":"Target for attacks","publicKey":"0xTARGET","userId":"{{bundleMalUser.id}}"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"targetBundle"}

