# ═══════════════════════════════════════════════════════════════
# ActionGraphBundleController Comprehensive QA
# Covers: create, get, getall, generate, deploy, delete, auth
# ═══════════════════════════════════════════════════════════════
{"_suiteVars":{"suitePrefix":"actiongraphbundlecontroller_qa"}}

# ─── Seed User ───
{"id":"seed_user","description":"Register user for action graph bundle tests","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_bundleqa","email":"{{suitePrefix}}_bundle@qa.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bundleUser"}
{"id":"login_user","description":"Login as action graph bundle test user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_bundle@qa.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"bundleAuth"}

# ─── Create bundles ───
{"id":"create_bundle_basic","description":"Create basic action graph bundle","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"name":"BasicBundle","description":"Basic bundle for QA","publicKey":"0xTESTPUBKEY123","userId":"{{bundleUser.id}}"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bundleBasic"}
{"id":"create_bundle_advanced","description":"Create advanced action graph bundle with all fields","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"name":"AdvancedBundle","description":"Advanced bundle with binding","publicKey":"0xADVANCEDPUBKEY456","userId":"{{bundleUser.id}}"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bundleAdvanced"}
{"id":"create_bundle_unicode","description":"Create bundle with Unicode name","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"name":"Bundle_测试","description":"Unicode test bundle","publicKey":"0xUNICODE789","userId":"{{bundleUser.id}}"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bundleUnicode"}

# ─── Get Tests ───
{"id":"get_bundle_by_id","description":"Get bundle by ID","method":"GET","path":"/api/actiongraphbundle/{{bundleBasic.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"get_nonexistent_bundle","description":"Get non-existent bundle","method":"GET","path":"/api/actiongraphbundle/00000000-0000-0000-0000-000000000000","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":404}
{"id":"get_all_bundles","description":"List all bundles","method":"GET","path":"/api/actiongraphbundle","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}

# ─── Generate Tests ───
{"id":"generate_bundle_algorand","description":"Generate dApp for Algorand","method":"POST","path":"/api/actiongraphbundle/{{bundleBasic.id}}/generate","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"targetChain":"Algorand","boundHolonIds":[],"config":{"theme":"dark","debug":true}},"expectedStatus":200}
{"id":"generate_bundle_solana","description":"Generate dApp for Solana","method":"POST","path":"/api/actiongraphbundle/{{bundleAdvanced.id}}/generate","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"targetChain":"Solana","boundHolonIds":[],"config":{"theme":"light","rpc":"devnet"}},"expectedStatus":200}

# ─── Deploy Tests ───
{"id":"deploy_bundle_basic","description":"Deploy generated bundle","method":"POST","path":"/api/actiongraphbundle/{{bundleBasic.id}}/deploy","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"deploy_bundle_advanced","description":"Deploy advanced bundle","method":"POST","path":"/api/actiongraphbundle/{{bundleAdvanced.id}}/deploy","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}

# ─── Update via CreateOrUpdate (upsert) ───
{"id":"update_bundle_via_upsert","description":"Update existing bundle via CreateOrUpdate","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"name":"BasicBundle","description":"Updated description via upsert","publicKey":"0xUPDATEDPUBKEY999","userId":"{{bundleUser.id}}"},"expectedStatus":200}

# ─── Auth Tests ───
{"id":"get_bundle_unauthorized","description":"Get bundle without auth","method":"GET","path":"/api/actiongraphbundle/{{bundleBasic.id}}","headers":{},"expectedStatus":401}
{"id":"create_bundle_unauthorized","description":"Create bundle without auth","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json"},"body":{"name":"UnauthBundle","description":"Should fail"},"expectedStatus":401}
{"id":"delete_bundle_unauthorized","description":"Delete bundle without auth","method":"DELETE","path":"/api/actiongraphbundle/{{bundleBasic.id}}","headers":{},"expectedStatus":401}
{"id":"generate_bundle_unauthorized","description":"Generate without auth","method":"POST","path":"/api/actiongraphbundle/{{bundleBasic.id}}/generate","headers":{"Content-Type":"application/json"},"body":{"targetChain":"Algorand"},"expectedStatus":401}

# ─── Deploy before generate should fail ───
{"id":"create_fresh_bundle","description":"Create fresh bundle for deploy-before-generate test","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bundleAuth.token}}"},"body":{"name":"FreshBundle","description":"No generation yet","publicKey":"0xFRESH","userId":"{{bundleUser.id}}"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bundleFresh"}
{"id":"deploy_before_generate","description":"Deploy bundle that was never generated should fail","method":"POST","path":"/api/actiongraphbundle/{{bundleFresh.id}}/deploy","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":400}

# ─── Cleanup ───
{"id":"delete_bundle_basic","description":"Delete basic bundle","method":"DELETE","path":"/api/actiongraphbundle/{{bundleBasic.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"delete_bundle_advanced","description":"Delete advanced bundle","method":"DELETE","path":"/api/actiongraphbundle/{{bundleAdvanced.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"delete_bundle_unicode","description":"Delete unicode bundle","method":"DELETE","path":"/api/actiongraphbundle/{{bundleUnicode.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"delete_bundle_fresh","description":"Delete fresh bundle","method":"DELETE","path":"/api/actiongraphbundle/{{bundleFresh.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
{"id":"verify_deleted_bundle","description":"Verify deleted bundle returns 404","method":"GET","path":"/api/actiongraphbundle/{{bundleBasic.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":404}
{"id":"cleanup_user","description":"Delete test user","method":"DELETE","path":"/api/user/{{bundleUser.id}}","headers":{"Authorization":"Bearer {{bundleAuth.token}}"},"expectedStatus":200}
