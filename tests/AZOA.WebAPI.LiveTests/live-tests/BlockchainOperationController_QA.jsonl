# ═══════════════════════════════════════════════════════════════
# BlockchainOperationController Comprehensive QA
# Covers: query by ID, query by user, empty result sets, auth
# ═══════════════════════════════════════════════════════════════
{"_suiteVars":{"suitePrefix":"blockchainoperationcontroller_qa"}}

# ─── Seed User with Wallet ───
{"id":"seed_user","description":"Register user for blockchain operation tests","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_blockchainqa","email":"{{suitePrefix}}_blockchain@qa.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"id":"result.id"},"saveAs":"bcUser"}
{"id":"login_user","description":"Login as blockchain test user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_blockchain@qa.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"bcAuth"}
{"id":"add_wallet","description":"Add Algorand wallet","method":"POST","path":"/api/user/{{bcUser.id}}/wallets","headers":{"Content-Type":"application/json","Authorization":"Bearer {{bcAuth.token}}"},"body":{"chainType":"Algorand","address":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY5HFKQ","label":"BlockchainQA"},"expectedStatus":200,"extract":{"walletId":"result.id"},"saveAs":"bcWallet"}

# ─── Query Operations (Empty Set) ───
{"id":"get_ops_by_user_empty","description":"Get operations for user with no operations","method":"GET","path":"/api/blockchainoperation/user/{{bcUser.id}}","headers":{"Authorization":"Bearer {{bcAuth.token}}"},"expectedStatus":200}
{"id":"get_op_by_id_nonexistent","description":"Get non-existent operation by ID","method":"GET","path":"/api/blockchainoperation/00000000-0000-0000-0000-000000000000","headers":{"Authorization":"Bearer {{bcAuth.token}}"},"expectedStatus":404}

# ─── Auth Tests ───
{"id":"get_op_unauthorized","description":"Get operation without auth","method":"GET","path":"/api/blockchainoperation/00000000-0000-0000-0000-000000000000","headers":{},"expectedStatus":401}
{"id":"get_ops_by_user_unauthorized","description":"Get operations by user without auth","method":"GET","path":"/api/blockchainoperation/user/{{bcUser.id}}","headers":{},"expectedStatus":401}
{"id":"get_ops_wrong_user_id","description":"Get operations with malformed user ID in path","method":"GET","path":"/api/blockchainoperation/user/not-a-guid","headers":{"Authorization":"Bearer {{bcAuth.token}}"},"expectedStatus":404}

# ─── Cleanup ───
{"id":"cleanup_wallet","description":"Remove seeded wallet","method":"DELETE","path":"/api/user/{{bcUser.id}}/wallets/{{bcWallet.walletId}}","headers":{"Authorization":"Bearer {{bcAuth.token}}"},"expectedStatus":200}
{"id":"cleanup_user","description":"Delete seeded user","method":"DELETE","path":"/api/user/{{bcUser.id}}","headers":{"Authorization":"Bearer {{bcAuth.token}}"},"expectedStatus":200}
