# ═══════════════════════════════════════════════════════════════
# ActionGraphBundleController live API payloads
# End-to-end action graph bundle lifecycle: create, get all, get by id, generate, deploy, delete.
# ═══════════════════════════════════════════════════════════════
{"_suiteVars":{"suitePrefix":"actiongraphbundlecontroller"}}
{"id":"seed_user","description":"Register user for action graph bundle tests","method":"POST","path":"/api/user/register","headers":{"Content-Type":"application/json"},"body":{"username":"{{suitePrefix}}_bundletest","email":"{{suitePrefix}}_bundle@test.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"userId":"result.id"},"saveAs":"suser"}
{"id":"login_seed","description":"Login as action graph bundle test user","method":"POST","path":"/api/user/login","headers":{"Content-Type":"application/json"},"body":{"email":"{{suitePrefix}}_bundle@test.azoa","password":"TestPass123!"},"expectedStatus":200,"extract":{"token":"result"},"saveAs":"sauth"}
{"id":"create_bundle","description":"Create an action graph bundle","method":"POST","path":"/api/actiongraphbundle","headers":{"Content-Type":"application/json","Authorization":"Bearer {{sauth.token}}"},"body":{"name":"LiveBundle","description":"Test bundle from live harness","publicKey":"0xTESTPUBLICKEY123","userId":"{{suser.userId}}"},"expectedStatus":200,"extract":{"bundleId":"result.id"},"saveAs":"bundle1"}
{"id":"get_bundle","description":"Get the created bundle","method":"GET","path":"/api/actiongraphbundle/{{bundle1.bundleId}}","headers":{"Authorization":"Bearer {{sauth.token}}"},"expectedStatus":200}
{"id":"get_all_bundles","description":"List all bundles","method":"GET","path":"/api/actiongraphbundle","headers":{"Authorization":"Bearer {{sauth.token}}"},"expectedStatus":200}
{"id":"generate_bundle","description":"Generate dApp for the bundle","method":"POST","path":"/api/actiongraphbundle/{{bundle1.bundleId}}/generate","headers":{"Content-Type":"application/json","Authorization":"Bearer {{sauth.token}}"},"body":{"targetChain":"Algorand","boundHolonIds":[],"config":{"theme":"dark"}},"expectedStatus":200}
{"id":"delete_bundle","description":"Delete the bundle","method":"DELETE","path":"/api/actiongraphbundle/{{bundle1.bundleId}}","headers":{"Authorization":"Bearer {{sauth.token}}"},"expectedStatus":200}
{"id":"cleanup_user","description":"Clean up the temp user","method":"DELETE","path":"/api/user/{{suser.userId}}","headers":{"Authorization":"Bearer {{sauth.token}}"},"expectedStatus":200}
