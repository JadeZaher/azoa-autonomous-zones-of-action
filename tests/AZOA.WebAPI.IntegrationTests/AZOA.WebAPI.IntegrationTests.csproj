<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- Moq: only for chain-provider edge fakes; internal collaborators stay real. See Http/AGENTS.md. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- BCrypt is referenced in TestDataBuilders (UserBuilder.Build hashes passwords). -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Real Ed25519 client signatures for the node-admin HTTP flows; aliased like the API project to avoid the legacy 1.8.8 collision. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" Aliases="BCCrypto2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\AZOA.WebAPI.csproj" />
    <!-- SurrealForge SurrealDB client (from nuget.org). The integration harness
         does per-test namespace setup/teardown via HttpClient + the client's
         types where deserialization is needed. -->
    <PackageReference Include="SurrealForge.Client" Version="1.3.0" />
  </ItemGroup>

</Project>
