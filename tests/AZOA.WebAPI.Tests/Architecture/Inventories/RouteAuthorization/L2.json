  { "route": "POST api/kyb/identomat/callback", "controller": "IdentomatKybCallbackController", "action": "Receive", "class": "non-value", "scope": "anonymous (vendor)", "enforcement": "constant-time callbackApiKey; verdict re-fetched from /result" },
  { "route": "POST api/operator/hosted-sessions/{sessionId}/reconcile", "controller": "HostedSessionReconciliationController", "action": "Reconcile", "class": "non-value", "scope": "RecentNodeOperatorSession", "enforcement": "operator policy; 20-1000 char evidence; vendor existence proven by /result/; audited CAS" },
  { "route": "POST api/operator/hosted-sessions/{sessionId}/refresh", "controller": "HostedSessionReconciliationController", "action": "Refresh", "class": "non-value", "scope": "RecentNodeOperatorSession", "enforcement": "operator policy; authoritative re-fetch only; audited as OperatorRefresh" },
