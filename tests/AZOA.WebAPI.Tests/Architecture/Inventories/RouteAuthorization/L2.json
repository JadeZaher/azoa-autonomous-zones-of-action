[
  { "route": "POST api/kyc/session", "controller": "KycController", "action": "BeginSession", "class": "non-value", "scope": "FirstPartyLogin (no acting tenant)", "enforcement": "policy FirstPartyLogin + acting-tenant Forbid; rate limit financial; subject from claim" },
  { "route": "POST api/kyc/refresh", "controller": "KycController", "action": "Refresh", "class": "non-value", "scope": "FirstPartyLogin (no acting tenant)", "enforcement": "policy FirstPartyLogin + acting-tenant Forbid; rate limit financial; only the caller's own open attempt" },
  { "route": "POST api/kyc/submit", "controller": "KycController", "action": "Submit", "class": "non-value", "scope": "FirstPartyLogin (no acting tenant)", "enforcement": "policy FirstPartyLogin + acting-tenant Forbid; subject from claim" },
  { "route": "GET api/kyc/status/summary", "controller": "KycController", "action": "GetStatusSummary", "class": "non-value", "scope": "kyc:read for API keys and acting tenants", "enforcement": "scope check; an acting tenant reads only its tenant-scoped attempt" },
