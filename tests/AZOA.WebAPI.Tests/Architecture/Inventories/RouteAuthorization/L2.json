  { "route": "POST api/tenant/business-verification/refresh", "controller": "TenantBusinessVerificationController", "action": "Refresh", "class": "non-value", "scope": "TenantBusinessVerification; kyc:read for API keys", "enforcement": "policy + scope; tenant from claim" },
  { "route": "PUT api/tenant/kyc/provider", "controller": "TenantKycConfigurationController", "action": "SelectProvider", "class": "non-value", "scope": "RecentFirstPartyLogin", "enforcement": "recent first-party login; tenant from claim; override allow-list" },
  { "route": "POST api/operator/kyc/aml-reviews/{userId}/decision", "controller": "AmlReviewController", "action": "Decide", "class": "non-value", "scope": "RecentNodeOperatorSession", "enforcement": "operator policy; audited decision" }
