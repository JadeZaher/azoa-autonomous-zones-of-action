<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- This is an executable node host. Reusable NuGet surfaces live in their
         own packages; do not accidentally publish the host as a library. -->
    <IsPackable>false</IsPackable>
    <!-- Enforcement teeth: the app project is IDE0005-clean, so a NEW unused using
         here fails the build (not just warns). Style severities live in the root
         .editorconfig; EnforceCodeStyleInBuild (Directory.Build.props) surfaces them.
         Packages/tests stay at warning to avoid breaking their pre-existing baseline. -->
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005</WarningsAsErrors>
    <!-- IDE0005 is only reported at build when XML docs are generated (Roslyn limitation);
         the doc file exists to give the rule teeth, so XML-doc diagnostics stay silent (round 4 W0). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1734;CS0419;CS1574;CS1570</NoWarn>
    <!-- Alpha version stamp (final-hardening-cutover Phase H, H5). Bump per
         CHANGELOG.md entry; see docs/NODE-HOST.md for the release process. -->
    <Version>0.1.0-alpha</Version>
    <InformationalVersion>0.1.0-alpha</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- ActionDefinition models are included (no longer excluded) -->
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Compile Remove="StrykerOutput\**\*.cs" />
    <Content Remove="StrykerOutput\**\*" />
    <None Remove="StrykerOutput\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Federated sign-in (Phase 1B). The Google handler is first-party Microsoft and
         carries Microsoft.AspNetCore.Authentication.OAuth transitively, which supplies
         the generic AddOAuth used for GitHub. Deliberately NO third-party provider
         package: the authorization-code + PKCE exchange is framework code either way,
         and the house rule is to minimise external dependencies. Hand-rolling the token
         exchange is forbidden — see Services/Auth/AGENTS.md. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Vetted, pure-managed secp256k1 ECDSA recovery for Wormhole VAA Guardian
         signature verification (Secp256k1VaaSignatureVerifier). Official Bouncy
         Castle (owner: LegionOfTheBouncyCastle); no native binaries. This is the
         single approved external crypto dependency — chosen over homebake curve
         math for ecrecover correctness. An `extern alias` (BCCrypto2) binds the
         verifier UNAMBIGUOUSLY to this 2.x assembly: the Algorand2/Solana SDKs
         transitively bundle the legacy BouncyCastle.Crypto 1.8.8, whose
         identically-named types (ECPoint/BigInteger/ECCurve) would otherwise
         collide. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" Aliases="BCCrypto2" />
    <PackageReference Include="Algorand2" Version="2.0.0.2024051911" />
    <PackageReference Include="Solana.Rpc" Version="8.7.0" />
    <PackageReference Include="Solana.Wallet" Version="8.7.0" />
    <!-- SPL Token / Associated Token Account / System program instruction builders
         (Solnet). Required by the SolanaProvider build→sign→submit pipeline so the
         SPL mint/burn/transfer instruction encoding is the SDK's, not hand-rolled. -->
    <PackageReference Include="Solana.Programs" Version="8.7.0" />
    <!-- Nethereum (EthereumProvider). Deliberately NOT the Nethereum.Web3 umbrella:
         the provider owns its own HttpClient JSON-RPC transport so the house
         RetrySafety.Broadcast double-spend guard and the in-process test stub both
         still apply. What is imported is the part that must NOT be hand-rolled on a
         value path — EIP-2718/EIP-1559 typed-transaction RLP (Nethereum.Signer +
         its transitive Nethereum.Model/Nethereum.RLP), secp256k1 sign/recover
         (EthECKey), keccak-256 + EIP-55 checksums (Nethereum.Util), ABI call
         encoding/decoding (Nethereum.ABI), and hex quantity types (Nethereum.Hex).
         Nethereum.Signer transitively adds Portable.BouncyCastle 1.8.x
         (assembly BouncyCastle.Crypto); it does NOT collide with the aliased
         BouncyCastle.Cryptography 2.6.2 above because that one is bound only
         through `extern alias BCCrypto2` and so is absent from the global namespace. -->
    <PackageReference Include="Nethereum.Signer" Version="4.21.4" />
    <PackageReference Include="Nethereum.ABI" Version="4.21.4" />
    <PackageReference Include="Nethereum.Util" Version="4.21.4" />
    <PackageReference Include="Nethereum.Hex" Version="4.21.4" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <!-- Official Anthropic .NET MCP SDK (mcp-surface track). 1.3.0 latest stable
         as of 2026-05-24. ModelContextProtocol is the core; .AspNetCore wires
         the HTTP+SSE transport into the existing Kestrel pipeline so the /mcp
         endpoint sits behind the same JWT+ApiKey auth as REST. -->
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════
       SurrealForge SurrealDB package suite (published to nuget.org from
       github.com/Escherbridge/surrealforge; formerly the in-repo
       packages/Azoa.SurrealDb.* project suite):

       - SurrealForge.Client   → runtime: transport over the official
                                  SurrealDb.Net SDK (CBOR wire format from
                                  1.0.0), query builder, transactions,
                                  marshalling. Also hosts the
                                  [SurrealTable]/[Column]/[References]/etc.
                                  attribute surface that POCOs in
                                  Persistence/SurrealDb/Models/ decorate
                                  themselves with — [References] is what
                                  promotes a string column to a native CBOR
                                  record id on the write path.
       - SurrealForge.Schema   → AttributeSchemaScanner + SurqlEmitter +
                                  migration runner (also ships the
                                  `surrealforge` dotnet CLI tool).
       - SurrealForge.Analyzer → SRDB0001 analyzer (catches string-interpolated
                                  SurrealQL outside the safe layer); ships as an
                                  analyzer asset, so PrivateAssets=all.
       ═══════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <PackageReference Include="SurrealForge.Client" Version="1.3.0" />
    <PackageReference Include="SurrealForge.Schema" Version="1.3.0" />
    <!-- Analyzer ships as an analyzer asset in the package; PrivateAssets=all
         keeps it from flowing to downstream consumers of this project. -->
    <PackageReference Include="SurrealForge.Analyzer" Version="1.3.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure wire/codec types stay internal; their unit tests read them directly. -->
    <InternalsVisibleTo Include="AZOA.WebAPI.Tests" />
    <InternalsVisibleTo Include="AZOA.WebAPI.IntegrationTests" />
  </ItemGroup>
</Project>
